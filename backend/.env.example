# ==============================================================================
# LPU GoCart - Backend FastAPI Environment Configuration
# ==============================================================================

# Server Settings
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Allowed Origins for CORS (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,exp://192.168.1.100:8081

# Supabase Credentials
# Supabase URL and keys from Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Secret Service Role Key: used ONLY on server-side for administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct PostgreSQL Database URL (Settings -> Database -> URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your-db-password@localhost:5432/postgres

# JWT Authentication
JWT_SECRET_KEY=super-secret-lpu-gocart-signing-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Gateway Configuration
# Use 'demo' for simulated test payments or 'razorpay' for live gateway
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Business Logic Configuration
SEAT_LOCK_DURATION_MINUTES=5
GPS_UPDATE_FREQUENCY_SECONDS=3
QR_TICKET_SECRET=lpu-gocart-qr-verification-secret

