# ==============================================================================
# LPU GoCart - Central Environment Configuration Template
# Copy this file to appropriate app directories as specified below:
# - backend/.env
# - apps/admin-dashboard/.env
# - apps/student-app/.env
# - apps/driver-app/.env
# ==============================================================================

# --- SUPABASE CONFIGURATION (Database, Auth, Realtime) ---
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
# SERVICE_ROLE_KEY is secret and strictly for backend use only! Never expose to apps!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key
# Direct Postgres Connection URL (Settings -> Database -> Connection string -> URI)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- BACKEND FASTAPI CONFIGURATION ---
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,exp://192.168.1.100:8081

# --- JWT & SECURITY CONFIGURATION ---
JWT_SECRET_KEY=generate-a-strong-random-secret-key-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PAYMENT GATEWAY CONFIGURATION ---
# Options: 'demo' or 'razorpay'
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# --- WEBSOCKET & GPS TRACKING ---
GPS_UPDATE_INTERVAL_SECONDS=3
SEAT_LOCK_EXPIRATION_MINUTES=5

# --- MOBILE APPS (EXPO) PUBLIC API URLS ---
# When testing on Android device / emulator, use your computer's local Wi-Fi IP (e.g. 192.168.1.X)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws/tracking
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

